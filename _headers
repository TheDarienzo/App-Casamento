# Cabeçalhos de segurança — o Cloudflare Workers lê este arquivo ao servir
# os arquivos enviados em "Upload assets".
#
# A regra principal é a CSP: o navegador só executa e carrega o que estiver
# listado aqui. Como o app não tem script nem estilo escrito dentro do HTML,
# dá para ser estrito de verdade, sem 'unsafe-inline' no script.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://rgxkmntpdbvvqcwksrwl.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
